# Copy to .env (Compose) or /etc/morse.env (systemd). Keep mode 600.
MORSE_TOKEN=replace-with-openssl-rand-hex-32
MORSE_PROVIDER=demo
# Model provider:
# MORSE_PROVIDER=openai
# MORSE_BASE_URL=http://127.0.0.1:11434/v1
# MORSE_MODEL=your-model
# MORSE_API_KEY=server-only-key
# Existing agent CLI (install on the server as the morse user):
# MORSE_PROVIDER=command
# MORSE_AGENT_PROGRAM=/home/morse/bin/my-agent
# MORSE_AGENT_ARGS=["--prompt", "{prompt}", "--session", "{session_id}"]
# MORSE_AGENT_TIMEOUT_MS=1800000
